{
  "title": "ZCode 项目默认模型 · 两轮验证",
  "allowed_paths": [
    "desktop/examples/support/zcode_two_rounds.rs",
    "desktop/examples/ui_debug.rs",
    "specs/zcode-default-model-two-rounds/",
    "tests/support/zcode_two_rounds.rs",
    "tests/zcode_default_two_rounds.rs"
  ],
  "forbidden_paths": [
    "src/",
    "desktop/src/"
  ],
  "subtasks": [
    {
      "id": "T1",
      "title": "根集成测试：默认值存取、项目隔离与目录校验（测试替身 zcode）",
      "paths": [
        "tests/zcode_default_two_rounds.rs",
        "tests/support/zcode_two_rounds.rs"
      ],
      "criteria": [
        "AC-1",
        "AC-2",
        "AC-9"
      ],
      "check": [
        "cargo",
        "test",
        "--locked",
        "--test",
        "zcode_default_two_rounds",
        "default_"
      ]
    },
    {
      "id": "T2",
      "title": "根集成测试：两次运行证据 evidence.json.request、时间线取值、旧记录兼容",
      "paths": [
        "tests/zcode_default_two_rounds.rs",
        "tests/support/zcode_two_rounds.rs"
      ],
      "criteria": [
        "AC-3",
        "AC-4",
        "AC-6",
        "AC-8"
      ],
      "check": [
        "cargo",
        "test",
        "--locked",
        "--test",
        "zcode_default_two_rounds"
      ]
    },
    {
      "id": "T3",
      "title": "Studio 场景 zcode-two-rounds：按 AC-3→AC-5→AC-7 走两轮并保存证据",
      "paths": [
        "desktop/examples/ui_debug.rs",
        "desktop/examples/support/zcode_two_rounds.rs"
      ],
      "criteria": [
        "AC-3",
        "AC-4",
        "AC-5",
        "AC-7"
      ],
      "check": [
        "cargo",
        "check",
        "--locked",
        "--manifest-path",
        "desktop/Cargo.toml",
        "--all-targets"
      ]
    },
    {
      "id": "T3b",
      "title": "Studio 场景 zcode-default-projects / zcode-timeline-reopen / zcode-legacy-open（见 design.md 5a）",
      "paths": [
        "desktop/examples/ui_debug.rs",
        "desktop/examples/support/zcode_two_rounds.rs"
      ],
      "criteria": [
        "AC-2",
        "AC-6",
        "AC-8"
      ],
      "check": [
        "cargo",
        "check",
        "--locked",
        "--manifest-path",
        "desktop/Cargo.toml",
        "--all-targets"
      ]
    },
    {
      "id": "T4",
      "title": "回归、GUI 实跑与验证记录",
      "paths": [
        "specs/zcode-default-model-two-rounds/validation.md"
      ],
      "criteria": [
        "AC-1",
        "AC-2",
        "AC-3",
        "AC-4",
        "AC-5",
        "AC-6",
        "AC-7",
        "AC-8",
        "AC-9"
      ],
      "check": [
        "cargo",
        "test",
        "--locked"
      ]
    }
  ],
